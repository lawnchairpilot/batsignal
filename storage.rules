rules_version = '2';

// Paths come from batsignal/Services/PhotoStorageService.swift. Note that the
// download URLs the app stores in Firestore carry an access token and bypass
// these rules by design, so the read rules here govern SDK access only.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Uploads are JPEGs the client downscales to 2048px on the long edge and
    // re-encodes at 0.8 quality, which lands a phone photo well under a
    // megabyte. The ceiling is here to stop the bucket being used as free
    // storage for something else, so it only has to sit above anything the app
    // itself produces — not above whatever a phone camera can emit.
    function isImageUnder(megabytes) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < megabytes * 1024 * 1024;
    }

    // A size cap alone still lets one account upload forever. enforceUploadQuota
    // in functions/src/index.ts counts uploads per user against a rolling
    // 24-hour window and, past the limit, deletes the object and writes an
    // uploadBlocks document — which is what this reads. Rules can't count, so
    // the counting lives server-side and only its verdict is checked here.
    //
    // The common case is one read that finds nothing. Only an account that has
    // actually tripped the limit costs the second read.
    function notRateLimited() {
      return !firestore.exists(/databases/(default)/documents/uploadBlocks/$(request.auth.uid))
        || firestore.get(/databases/(default)/documents/uploadBlocks/$(request.auth.uid))
             .data.get('until', request.time) <= request.time;
    }

    match /profile-photos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && isImageUnder(6)
        && notRateLimited();
    }

    // The uid in the path is what makes an upload attributable: it's what lets
    // the quota above count per account, lets cleanupOnUserDelete sweep by
    // prefix, and makes an abusive uploader identifiable at all. The filename
    // is still a UUID, so ownership of a *specific* photo can't be re-checked
    // on overwrite or delete — both stay refused, and cleanup runs as admin.
    match /event-photos/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && isImageUnder(6)
        && notRateLimited();
      allow update, delete: if false;
    }

    // Event photos written before uploads were filed under a uid. Readable so
    // existing signals keep their image; nothing new can be written here.
    match /event-photos/{fileName} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
