# Xcode Derived Data
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Packages/

# CocoaPods (if you ever use it)
Pods/
*.xcworkspace
!*.xcodeproj/project.xcworkspace/

# Carthage (if you ever use it)
Carthage/Build/

# Firebase / Google Services
# Do NOT ignore GoogleService-Info.plist if you want teammates to build —
# but if solo and treating it as a secret, uncomment the next line:
# GoogleService-Info.plist

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# VS Code
.vscode/

# Environment / secrets
# `.env*` is the one that matters: `*.env` alone matches foo.env but NOT
# `.env`, `.env.local` or `.env.boolsignal`, which is how the last one ended
# up committed.
.env*
*.env
secrets.plist

# Firebase CLI debug output — noisy, and it transcribes whatever the CLI was
# doing at the time.
firebase-debug*.log
firebase-debug*.json
.firebase/

node_modules/
